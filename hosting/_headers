# Security headers for Netlify / Cloudflare Pages (copy to the site root at deploy; tools/build.mjs does this).
# Headers can do what the <meta> CSP cannot: block framing (clickjacking), force HTTPS, lock down device APIs.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; manifest-src 'self'; worker-src 'self'; connect-src 'self' https://overpass-api.de https://maps.mail.ru https://overpass.private.coffee https://nominatim.openstreetmap.org https://*.supabase.co https://api.github.com; base-uri 'none'; form-action 'none'; object-src 'none'; frame-ancestors 'none'; require-trusted-types-for 'script'; trusted-types qarib-sw; upgrade-insecure-requests
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
